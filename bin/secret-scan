#!/usr/bin/env php8.4
<?php
// ใช้: bin/secret-scan [repo]  — รันก่อน commit: หา secret จริง (.env, salt/รหัสในโค้ดเดิม) ในไฟล์ที่จะเข้า git (พิมพ์แค่ชื่อไฟล์)
// หา secret จริงใน working tree (ไม่พิมพ์ค่า) — ค่าจาก .env (ยาว >= 6) + salt/redis pass ในโค้ดเดิม
$root = realpath($argv[1] ?? __DIR__."/..");
$secrets = [];
foreach (file("$root/.env", FILE_IGNORE_NEW_LINES) as $l) {
    if (preg_match('/^([A-Z0-9_]*(PASS|KEY|SECRET|SALT|TOKEN)[A-Z0-9_]*)=(.*)$/', $l, $m)) {
        $v = trim($m[3], " \"'"); if (strlen($v) >= 6) $secrets[$m[1]] = stripcslashes($v);
    }
}
// โค้ดเดิมทั้งสำเนา bench และ webroot จริงของ SR (อ่านอย่างเดียว) — รหัส DB จริงอยู่ใน system_db.php ของ production
$c = '';
foreach (['/home/admin/bench/sr-old', '/home/admin/web/portal.srshippingsystem.com/public_html'] as $d) {
    foreach (['system_status_function.php', 'system_config.php', 'system_db.php'] as $f) $c .= (string) @file_get_contents("$d/$f");
}
// key ภายนอก (Azure/Mailgun/notify) ที่โค้ดเดิมอ่านจากไฟล์
foreach (array_merge(glob('/home/admin/tmp/.secrets/*') ?: [], ['/home/admin/tmp/notify.secret']) as $kf) {
    $v = trim((string) @file_get_contents($kf)); if (strlen($v) >= 8) $secrets['file:'.basename($kf)] = $v;
}
preg_match_all("/define\(\s*'(redispass|password)'\s*,\s*'([^']+)'/", $c, $m, PREG_SET_ORDER); foreach ($m as $x) $secrets['legacy:'.$x[1]] = $x[2];
// API key ที่ฝังในโค้ดเดิม: SendGrid (SG.xxx — อยู่ใน comment ของ system_config.php ของ SR) และค่า define ที่ชื่อมี password/key/token/secret
preg_match_all("/(SG\.[A-Za-z0-9_.\-]{20,})/", $c, $m); foreach (array_unique($m[1]) as $i => $x) $secrets['legacy:sendgrid'.$i] = $x;
preg_match_all("/define\(\s*'([a-z_0-9]*(password|key|token|secret)[a-z_0-9]*)'\s*,\s*'([^']{8,})'/i", $c, $m, PREG_SET_ORDER); foreach ($m as $x) $secrets['legacy:'.$x[1]] = $x[3];
preg_match_all("/\\\$salt\s*=\s*'([^']+)'/", $c, $m); foreach ($m[1] as $i => $x) $secrets['legacy:salt'.$i] = $x;
$tw = trim(@file_get_contents('/root/sr-tools/bench-test-password')); if ($tw) $secrets['bench-test-password'] = $tw;
$files = explode("\0", trim(shell_exec("cd ".escapeshellarg($root)." && git ls-files -z --cached --others --exclude-standard")));
$hits = 0;
foreach ($files as $f) { if ($f === '' || !is_file("$root/$f")) continue; $d = file_get_contents("$root/$f");
  foreach ($secrets as $k => $v) if (strpos($d, $v) !== false) { echo "HIT $k in $f\n"; $hits++; } }
echo "checked ".count($files)." files against ".count($secrets)." secrets: $hits hits\n";
