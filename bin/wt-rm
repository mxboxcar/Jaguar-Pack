#!/bin/bash
# ลบ worktree ของกลุ่ม (หยุด wt-serve, git worktree remove, ลบ branch ถ้าสั่ง) — ไม่แตะ repo หลัก/ไฟล์อื่น
#   ปกติ: ลบเฉพาะ worktree (branch mod/<group> ยังอยู่ ไม่เสียงาน)
#   --branch : ลบ branch mod/<group> ด้วย (ต้อง merge แล้ว หรือใส่ --force)
#   --force  : ลบแม้มีไฟล์ที่ยังไม่ commit / branch ที่ยังไม่ merge (งานหาย!)
# ใช้: bin/wt-rm <group> [--branch] [--force]     (รันด้วย root)
set -euo pipefail
JL_GROUPS="tracking shop order payment balance money-move points lot warehouse users messaging reports settings"
G=${1:-}; shift || true
DEL_BRANCH=0; FORCE=0
while [ $# -gt 0 ]; do
    case "$1" in
        --branch) DEL_BRANCH=1 ;;
        --force) FORCE=1 ;;
        *) echo "ไม่รู้จัก: $1" >&2; exit 1 ;;
    esac
    shift
done
case " $JL_GROUPS " in
    *" $G "*) ;;
    *) [[ "$G" =~ ^zz-[a-z0-9-]{1,20}$ ]] || { echo "ใช้: bin/wt-rm <group> [--branch] [--force]" >&2; exit 1; } ;;
esac
[ "$(id -u)" = 0 ] || { echo "ต้องรันด้วย root" >&2; exit 1; }

REPO=$(cd "$(dirname "$0")/.." && git rev-parse --show-toplevel)
REPO=$(cd "$REPO" && cd "$(git rev-parse --git-common-dir)/.." && pwd)
ROOT=${JL_WT_ROOT:-/home/admin/laravel/jl-wt}
WT=$ROOT/$G
BR=mod/$G

if [ -d "$WT" ]; then
    # ไฟล์ที่ git ไม่รู้จัก (symlink .env/vendor/public/assets, storage ที่ ignore) ไม่นับเป็นงานค้าง
    if [ "$FORCE" = 0 ] && [ -n "$(git -C "$WT" status --porcelain --untracked-files=normal)" ]; then
        echo "worktree มีไฟล์ที่ยังไม่ commit:" >&2; git -C "$WT" status --short >&2
        echo "commit ก่อน หรือใส่ --force (งานหาย)" >&2; exit 1
    fi
    "$REPO/bin/wt-serve" "$G" --stop >/dev/null 2>&1 || true
    # symlink/ไฟล์ ignore ต้องลบเองก่อน (git worktree remove ไม่ยอมลบไฟล์ ignore ถ้าไม่ --force)
    # (ลบเฉพาะลิงก์ ไม่ตาม symlink เข้าไปลบของ main/mirror: rm -rf ไม่ตาม symlink ที่อยู่ข้างใน)
    rm -f "$WT/.env" "$WT/public/assets"
    if [ -L "$WT/vendor" ]; then rm -f "$WT/vendor"; elif [ -d "$WT/vendor" ]; then rm -rf -- "$WT/vendor"; fi
    git -C "$REPO" worktree remove --force "$WT"
    echo "ลบ worktree $WT แล้ว"
else
    echo "ไม่มี worktree $WT"
fi
git -C "$REPO" worktree prune

if [ "$DEL_BRANCH" = 1 ] && git -C "$REPO" show-ref --verify --quiet "refs/heads/$BR"; then
    if [ "$FORCE" = 1 ]; then git -C "$REPO" branch -D "$BR"; else git -C "$REPO" branch -d "$BR"; fi
fi
